\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces S1 backbone check. Heuristic rows are the 5-seed means from Table\nonbreakingspace \ref {tab:interview}; \texttt  {gpt-4o-mini} rows are 3-seed means ($\{7,11,19\}$). Emb.\ is the share of rumour hops that embellish a detail. Journalist share and line count are unchanged; the LLM alludes to the leak on the floor more often (range $0.059$--$0.171$). Memb.\ and Emb.\ differ only through the seeds, since rumour transmission does not involve the model.}}{6}{table.caption.21}\protected@file@percent }
\newlabel{tab:backbone}{{2}{6}{S1 backbone check. Heuristic rows are the 5-seed means from Table~\ref {tab:interview}; \texttt {gpt-4o-mini} rows are 3-seed means ($\{7,11,19\}$). Emb.\ is the share of rumour hops that embellish a detail. Journalist share and line count are unchanged; the LLM alludes to the leak on the floor more often (range $0.059$--$0.171$). Memb.\ and Emb.\ differ only through the seeds, since rumour transmission does not involve the model}{table.caption.21}{}}
