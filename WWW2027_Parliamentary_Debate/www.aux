\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Emergent leak diffusion and selection (S1, $N{=}25$, 5-seed mean). A resignation rumour is seeded in one member in the wandelgang. Members reach $27\%$ awareness at day\nonbreakingspace 1 and $100\%$ by day\nonbreakingspace 7; the press is faster ($60\%$ then $100\%$); ministers lag ($0\%$ then $70\%$). Only $4.1\%$ of simulated Handelingen lines mention the leak. A Generative Agents ablation without the corridor network remains at the $5\%$ seed.\relax }}{6}{figure.caption.33}\protected@file@percent }
\newlabel{fig:diffusion}{{2}{6}{Emergent leak diffusion and selection (S1, $N{=}25$, 5-seed mean). A resignation rumour is seeded in one member in the wandelgang. Members reach $27\%$ awareness at day~1 and $100\%$ by day~7; the press is faster ($60\%$ then $100\%$); ministers lag ($0\%$ then $70\%$). Only $4.1\%$ of simulated Handelingen lines mention the leak. A Generative Agents ablation without the corridor network remains at the $5\%$ seed.\relax }{figure.caption.33}{}}
